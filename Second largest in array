int main() {
    int arr[5]={8,25,37,18,78};
    int i;
    int largest=arr[0];
    int secondlargest=arr[0];
    for (i=1;i<5;i++){
        if(arr[i]>largest)
        {
            largest=arr[i];
        }
    }
    for (i=0;i<5;i++)
    {
        if(arr[i]>secondlargest && arr[i]<largest)
        {
            secondlargest=arr[i];
        }
    }
    printf("Second largest :%d",secondlargest);
    return 0;
